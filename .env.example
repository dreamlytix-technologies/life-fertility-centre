# ---------------------------------------------------------------------------
# Copy to .env.local. NEVER commit real values.
# Anything without the NEXT_PUBLIC_ prefix stays on the server.
# ---------------------------------------------------------------------------

# Public canonical origin of the site (used for canonical URLs, OG, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3103

# Data store. Leave DATABASE_URL empty to run in DEMO mode (in-memory store,
# seeded from the app's content file, reset on restart).
DATABASE_URL=
# DATABASE_URL=postgresql://user:password@host:5432/life_fertility?schema=public

# Payment provider: "mock" (demo checkout, refuses to run in production
# unless ALLOW_MOCK_PAYMENTS=true) or "razorpay".
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Server-side secret for signing mock payments (auto-generated per process if empty)
MOCK_PAYMENT_SECRET=

# Transactional email: "console" (logs) or "resend"
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Life Fertility Centre <appointments@example.com>"

# Admin API. In DEMO mode a static bearer token protects /api/admin/*.
# With a database, admin sessions (AdminUser/AdminSession tables) are used.
ADMIN_API_TOKEN=change-me-to-a-long-random-string

# Salt used to hash IPs for rate limiting / spam protection
RATE_LIMIT_SALT=change-me
