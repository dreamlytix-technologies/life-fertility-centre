{
  "name": "life-fertility-centre",
  "version": "1.0.0",
  "private": true,
  "description": "Life Fertility Centre, Malda (Dr. Debchandan Roy): gynaecology, fertility and pregnancy care website with online consultation booking.",
  "scripts": {
    "dev": "next dev -p 3103",
    "build": "next build",
    "start": "next start -p 3103",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/core/booking/engine.test.ts src/content/site-settings.test.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts src/content/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.0",
    "@prisma/client": "6.19.3",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.66.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": { "node": ">=20.9" }
}
